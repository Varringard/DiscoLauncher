{
  "name": "discolauncher",
  "version": "1.0.0",
  "description": "DiscoLauncher — open source Minecraft launcher with multi-server management, 3D skin preview, and mod auto-sync",
  "main": "dist-electron/main.js",
  "author": "DiscoLauncher Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:exe": "npm run build && electron-builder --win",
    "start": "electron .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.discolauncher.app",
    "productName": "DiscoLauncher",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "varrimain",
        "repo": "DiscoLauncher"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DiscoLauncher.exe"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "minecraft-launcher-core": "^3.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^3.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
